{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": "container",
  "height": 560,
  "config": {
    "view": { "stroke": null },
    "legend": {
      "labelColor": "#244654",
      "titleColor": "#244654"
    },
    "text": {
      "font": "Arial"
    }
  },
  "description": "Dorling-style cartogram for Australian surfing participation by state and territory, using approximate geographic positions and circle size to show the selected measure.",
  "usermeta": {
    "title": "How Do States and Territories Compare in Surfing Participation?",
    "defaultMetric": "count",
    "metricOptions": [
      {
        "value": "count",
        "label": "Estimated participants",
        "unit": "people"
      },
      {
        "value": "rate",
        "label": "Adult participation rate",
        "unit": "%"
      }
    ],
    "interpretations": {
      "count": "New South Wales has the largest estimated adult surfing population (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). Together, these four states account for about 91% of the combined state and territory total. The map-like placement shows that the largest surfing populations are concentrated in the eastern seaboard states, especially NSW and Queensland, while smaller jurisdictions such as the ACT, Tasmania and the Northern Territory contribute far fewer participants in absolute terms.",
      "rate": "When adjusted for population size, the ranking changes. Western Australia records the highest adult participation rate (1.76%), narrowly ahead of New South Wales (1.67%), followed by Queensland (1.38%) and Tasmania (1.36%). This indicates that although NSW dominates in sheer participant numbers, surfing is slightly more prevalent among adults in WA. The rate view therefore complements the participant-count view by revealing differences in surfing intensity rather than total scale."
    },
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ],
    "highlights": {
      "count": "NSW leads in absolute participation: an estimated 117,953 adult surfers.",
      "rate": "WA leads in participation rate: 1.76% of adults."
    }
  },
  "data": {
    "url": "data/ausplay_surf_cartogram_2025.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "metric",
        "equal": "count"
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36 || datum.id == '036'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eef5f3",
        "stroke": "#a6bcbc",
        "strokeWidth": 1.4
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#ffffff",
        "strokeWidth": 1.6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [0, 125000],
            "range": [30, 5200]
          },
          "legend": {
            "title": "Estimated participants (people)",
            "orient": "top",
            "direction": "horizontal",
            "values": [0, 25000, 50000, 75000, 100000, 125000],
            "format": "~s",
            "labelFontSize": 13,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelPadding": 10,
            "offset": 8,
            "symbolStrokeColor": "#35626d",
            "symbolFillColor": "#5c959e"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "QLD", "VIC", "WA", "SA", "TAS", "ACT", "NT"],
            "range": ["#0072B2", "#E69F00", "#CC79A7", "#D55E00", "#009E73", "#7B61A8", "#8C6D31", "#666666"]
          },
          "legend": {
            "title": "State / territory",
            "orient": "right",
            "direction": "vertical",
            "columns": 1,
            "symbolSize": 180,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelFontSize": 13,
            "labelLimit": 140,
            "offset": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "participants",
            "title": "Estimated participants",
            "format": ","
          },
          {
            "field": "participation_rate_pct",
            "title": "Adult participation rate (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "dy": -26,
        "color": "#173946"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "dy": 8,
        "color": "#173946"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label"
        }
      }
    }
  ],
  "padding": {
    "left": 20,
    "right": 140,
    "top": 60,
    "bottom": 20
  }
}
