{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    }
  },
  "description": "State or territory adult surfing participation, switch between estimated number of participants and estimated percent of adult residents.",
  "usermeta": {
    "title": "Which States Lead in Surfing Participation?",
    "defaultMetric": "count",
    "metricOptions": [
      {
        "value": "count",
        "label": "Estimated participants",
        "unit": "people"
      },
      {
        "value": "rate",
        "label": "Adult participation rate",
        "unit": "%"
      }
    ],
    "interpretations": {
      "count": "New South Wales leads in estimated adult surfers (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). Together these four states represent approximately 91% of the summed state and territory estimates. This pattern partly reflects population size; the number of participants alone does not establish how widespread surfing is among residents. Switching to participation rate provides a population-adjusted comparison.",
      "rate": "Western Australia ranks first in estimated adult surfing participation rate (1.76%), just ahead of New South Wales (1.67%). Queensland (1.38%) and Tasmania (1.36%) follow. Compared with the participant-count ranking, WA rises from fourth to first, illustrating why population-adjusted measures matter. Differences are survey estimates, however, and small gaps should not be presented as statistically significant without uncertainty intervals."
    },
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ],
    "highlights": {
      "count": "NSW leads by volume: 117,953 estimated adult surfers.",
      "rate": "WA leads by participation rate: 1.76% of adults."
    }
  },
  "height": 360,
  "data": {
    "url": "data/ausplay_surf_ranking_2025.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "metric",
        "equal": "count"
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {
        "field": "value",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 10
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "zero": true,
        "nice": true
      },
      "axis": {
        "title": "Estimated surfing participants aged 15+",
        "tickCount": 5,
        "grid": true,
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State / territory"
      },
      {
        "field": "participants",
        "title": "Estimated participants",
        "format": ","
      },
      {
        "field": "participation_rate_pct",
        "title": "Participation rate (%)",
        "format": ".2f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#9bb9bb",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "value"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 190,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "QLD",
              "VIC",
              "WA",
              "SA",
              "TAS",
              "ACT",
              "NT"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73",
              "#7B61A8",
              "#8C6D31",
              "#666666"
            ]
          },
          "legend": {
            "title": "State / territory",
            "orient": "bottom",
            "columns": 4,
            "symbolSize": 190,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelFontSize": 13,
            "columnPadding": 18,
            "rowPadding": 12,
            "labelLimit": 150,
            "offset": 14
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 11,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    }
  ]
}
