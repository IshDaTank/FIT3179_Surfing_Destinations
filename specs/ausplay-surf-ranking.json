{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": "container",
  "height": 520,
  "description": "Map-aligned proportional circle comparison of state/territory surfing participation. Circle size switches between count and rate; positions represent approximate geography.",
  "usermeta": {
    "title": "How Do States and Territories Compare in Surfing Participation?",
    "defaultMetric": "count",
    "metricOptions": [
      {
        "value": "count",
        "label": "Estimated participants",
        "unit": "people"
      },
      {
        "value": "rate",
        "label": "Adult participation rate",
        "unit": "%"
      }
    ],
    "interpretations": {
      "count": "NSW has the largest estimated adult surfing population (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). Together these four states account for about 91% of summed state and territory estimates. Circle size expresses participation, while position expresses approximate geography. This view is influenced by state population size and does not show where people surf.",
      "rate": "Western Australia has the highest estimated adult surfing participation rate (1.76%), just ahead of NSW (1.67%). Queensland (1.38%) and Tasmania (1.36%) follow. By adjusting for adult population, the map gives a contrasting perspective: WA becomes the largest circle even though NSW has substantially more surfers. Narrow differences are not necessarily statistically significant in survey estimates."
    },
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ],
    "highlights": {
      "count": "NSW leads in absolute participation: 117,953 estimated adult surfers.",
      "rate": "WA leads in participation rate: 1.76% of adults."
    }
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36 || datum.id == \"036\""
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eef5f3",
        "stroke": "#a6bcbc",
        "strokeWidth": 1.4
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_cartogram_2025.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#ffffff",
        "strokeWidth": 1.6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              125000
            ],
            "range": [
              36,
              5200
            ],
            "nice": false
          },
          "legend": null
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "QLD",
              "VIC",
              "WA",
              "SA",
              "TAS",
              "ACT",
              "NT"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73",
              "#7B61A8",
              "#8C6D31",
              "#666666"
            ]
          },
          "legend": {
            "title": "State / territory",
            "orient": "right",
            "direction": "vertical",
            "symbolSize": 180,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "participants",
            "title": "Estimated participants",
            "format": ",.0f"
          },
          {
            "field": "participation_rate_pct",
            "title": "Adult participation rate (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_cartogram_2025.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "dy": -27,
        "color": "#173946"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_cartogram_2025.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "dy": 10,
        "color": "#173946"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    }
  ],
  "padding": {
    "left": 14,
    "right": 20,
    "top": 20,
    "bottom": 22
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
