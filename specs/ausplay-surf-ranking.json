{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Rank Australian jurisdictions by adult surfing participant estimates or participation rates, AusPlay 2025.",
  "background": "#ffffff",
  "width": "container",
  "height": 390,
  "data": {
    "url": "data/ausplay_surf_ranking_2025.csv",
    "format": {
      "type": "csv"
    }
  },
  "usermeta": {
    "title": "Which States Lead in Surfing Participation?",
    "defaultMetric": "count",
    "metricOptions": [
      {
        "value": "count",
        "label": "Estimated participants",
        "unit": "people"
      },
      {
        "value": "rate",
        "label": "Participation rate",
        "unit": "%"
      }
    ],
    "highlights": {
      "count": "NSW leads by volume: 117,953 estimated adult surfers.",
      "rate": "WA leads by participation rate: 1.76% of adults."
    },
    "interpretations": {
      "count": "New South Wales has the largest estimated adult surfing population (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). These four states account for approximately 91% of the summed estimates. Larger populations contribute to higher absolute numbers, so participant counts alone cannot measure the prevalence of surfing.",
      "rate": "Western Australia has the highest estimated adult surfing participation rate (1.76%), narrowly ahead of New South Wales (1.67%). Queensland (1.38%) and Tasmania (1.36%) follow. WA rises from fourth by participant count to first by rate, showing the importance of population-adjusted comparisons. Small gaps should not be interpreted as statistically significant without uncertainty estimates."
    },
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025 state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "transform": [
    {
      "filter": {
        "field": "metric",
        "equal": "count"
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "domain": [8.5, 0.5],
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": null,
        "values": [1, 2, 3, 4, 5, 6, 7, 8],
        "labelExpr": "['NSW','QLD','VIC','WA','SA','TAS','ACT','NT'][datum.value - 1]",
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 10,
        "ticks": false,
        "grid": false,
        "domain": false
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "domain": [0, 125000],
        "nice": false
      },
      "axis": {
        "title": "Estimated adult surfing participants (people)",
        "values": [
          0, 25000, 50000, 75000, 100000, 125000
        ],
        "format": ",.0f",
        "grid": true,
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "participants",
        "type": "quantitative",
        "title": "Estimated participants",
        "format": ",.0f"
      },
      {
        "field": "participation_rate_pct",
        "type": "quantitative",
        "title": "Participation rate (%)",
        "format": ".2f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a4bec0",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "value"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 210,
        "stroke": "#ffffff",
        "strokeWidth": 1.6
      },
      "encoding": {
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW", "QLD", "VIC", "WA",
              "SA", "TAS", "ACT", "NT"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73",
              "#7B61A8",
              "#8C6D31",
              "#666666"
            ]
          },
          "legend": {
            "title": "State / territory",
            "orient": "bottom",
            "columns": 4,
            "symbolSize": 200,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "columnPadding": 22,
            "rowPadding": 12,
            "offset": 16
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 11,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "font": "Arial"
  }
}
