{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Sorted horizontal bar chart of National Surfing Reserves by state, using colour-blind-friendly categorical colours and arrow-connected annotations.",
  "usermeta": {
    "title": "Which States Have the Most Recognised Surfing Reserves?",
    "analysis": "New South Wales accounts for 11 of Australia's 19 listed National Surfing Reserves (58%), exceeding the eight listings across the other four represented states combined. Western Australia has three (16%), Queensland and South Australia have two each (11%), and Victoria has one (5%). One possible explanation for the uneven pattern is the history of the recognition program: National Surfing Reserves was formed in Sydney in 2005, and its first eight listed dedications, between 2006 and 2009, were all in NSW. This indicates an early concentration of formal recognition, but does not prove why it occurred. Designation also requires a successful nomination, local steering committee, community support and engagement with relevant authorities. These organisational requirements may contribute to differences in state representation, independently of the availability of surf breaks. Victoria's only listed reserve is Phillip Island, even though Bells Beach is an internationally recognised competition venue. The distinction illustrates that official heritage listings do not measure all surfing destinations, wave quality or visitor popularity. Tasmania and the Northern Territory have no entries in this register; the ACT is landlocked. The comparison therefore measures recognised sites rather than total surfing opportunities.",
    "sources": [
      {
        "label": "National Surfing Reserves — Official Register",
        "url": "https://surfingreserves.org.au/national-surfing-reserves/"
      },
      {
        "label": "National Surfing Reserves — Nomination Process",
        "url": "https://surfingreserves.org.au/nomination-process/"
      }
    ]
  },
  "data": {
    "url": "data/reserves.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": ["state"]
    },
    {
      "calculate": "datum.count / 19",
      "as": "share"
    }
  ],
  "width": "container",
  "height": 290,
  "background": "#ffffff",
  "padding": {
    "left": 10,
    "right": 8,
    "top": 14,
    "bottom": 8
  },
  "encoding": {
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of National Surfing Reserves",
      "scale": {
        "domain": [0, 17],
        "nice": false
      },
      "axis": {
        "values": [0, 3, 6, 9, 12, 15],
        "grid": true,
        "gridColor": "#e7efed",
        "domain": false,
        "tickColor": "#b7ceca",
        "labelColor": "#526b74",
        "titleColor": "#244654",
        "titlePadding": 13,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "titleFontWeight": "bold"
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": "States",
      "sort": ["NSW", "WA", "QLD", "SA", "VIC"],
      "scale": {
        "paddingInner": 0.35,
        "paddingOuter": 0.3
      },
      "axis": {
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelColor": "#244654",
        "labelPadding": 10,
        "titleColor": "#244654",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titlePadding": 16,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 29,
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "QLD", "VIC", "SA", "WA"],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#009E73",
              "#D55E00"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Listed reserves"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of national total"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "boxStart": 12.55,
            "boxEnd": 16.95,
            "labelX": 12.8,
            "label": "58% > other states (8)"
          },
          {
            "state": "VIC",
            "boxStart": 3.15,
            "boxEnd": 9.9,
            "labelX": 3.4,
            "label": "Only Phillip Island listed"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "height": 32,
        "cornerRadius": 5,
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "boxStart",
          "type": "quantitative"
        },
        "x2": {
          "field": "boxEnd"
        },
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#F8EBF3"
          },
          "value": "#E5F2FA"
        },
        "stroke": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#CC79A7"
          },
          "value": "#0072B2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "ruleStart": 11.85,
            "ruleEnd": 12.45
          },
          {
            "state": "VIC",
            "ruleStart": 1.75,
            "ruleEnd": 3
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1.7
      },
      "encoding": {
        "x": {
          "field": "ruleStart",
          "type": "quantitative"
        },
        "x2": {
          "field": "ruleEnd"
        },
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#CC79A7"
          },
          "value": "#0072B2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "pointX": 11.85
          },
          {
            "state": "VIC",
            "pointX": 1.75
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-left",
        "filled": true,
        "size": 72
      },
      "encoding": {
        "x": {
          "field": "pointX",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#CC79A7"
          },
          "value": "#0072B2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "labelX": 12.8,
            "label": "58% > other states (8)"
          },
          {
            "state": "VIC",
            "labelX": 3.4,
            "label": "Only Phillip Island listed"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "x": {
          "field": "labelX",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
