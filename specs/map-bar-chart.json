{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Sorted horizontal bar chart comparing National Surfing Reserves across five states, with maximum and minimum annotations.",
  "usermeta": {
    "title": "Which States Have the Most Recognised Surfing Reserves?",
    "analysis": "New South Wales leads with 11 of the 19 National Surfing Reserves (58%), more than the other four listed states combined (eight). Western Australia follows with three (16%), Queensland and South Australia have two each (11%), and Victoria has one (5%). The uneven pattern has a notable historical dimension: the recognition program was established in Sydney in 2005, and all eight dedications from 2006 to 2009 were in NSW. Recognition later spread west and south as local communities secured new dedications. The organisation's nomination process requires a local steering committee, community support and coordination with councils, suggesting that successful recognition reflects civic organisation as well as surfing heritage. Victoria's single listing at Phillip Island, for example, covers multiple renowned breaks on the island's southern coast. This comparison shows where formal recognition became most concentrated—and sets up Chart 3's exploration of how that distribution changed over time.",
    "sources": [
      {
        "label": "National Surfing Reserves — Official Register",
        "url": "https://surfingreserves.org.au/national-surfing-reserves/"
      },
      {
        "label": "Nomination Process",
        "url": "https://surfingreserves.org.au/nomination-process/"
      },
      {
        "label": "Phillip Island Reserve History",
        "url": "https://surfingreserves.org.au/phillip-island/"
      }
    ]
  },
  "data": {"url": "data/reserves.csv"},
  "transform": [
    {
      "aggregate": [{"op": "count", "as": "count"}],
      "groupby": ["state"]
    },
    {"calculate": "datum.count / 19", "as": "share"}
  ],
  "width": "container",
  "height": 290,
  "background": "#ffffff",
  "padding": {"left": 10, "right": 8, "top": 14, "bottom": 8},
  "encoding": {
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of National Surfing Reserves",
      "scale": {"domain": [0, 17], "nice": false},
      "axis": {
        "values": [0, 3, 6, 9, 12, 15],
        "grid": true,
        "gridColor": "#e7efed",
        "domain": false,
        "tickColor": "#b7ceca",
        "labelColor": "#526b74",
        "titleColor": "#244654",
        "titlePadding": 13,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "titleFontWeight": "bold"
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": "States",
      "sort": ["NSW", "WA", "QLD", "SA", "VIC"],
      "scale": {"paddingInner": 0.35, "paddingOuter": 0.3},
      "axis": {
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelColor": "#244654",
        "labelPadding": 10,
        "titleColor": "#244654",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titlePadding": 16,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 29,
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "QLD", "VIC", "SA", "WA"],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#009E73",
              "#D55E00"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "count", "type": "quantitative", "title": "Reserves"},
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of register"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {"field": "count", "type": "quantitative", "format": "d"}
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "boxStart": 12.55,
            "boxEnd": 16.95,
            "labelX": 12.8,
            "label": "11 > other four (8)"
          },
          {
            "state": "VIC",
            "boxStart": 3.15,
            "boxEnd": 9.9,
            "labelX": 3.4,
            "label": "Phillip Island only"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "height": 32,
        "cornerRadius": 5,
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "boxStart", "type": "quantitative"},
        "x2": {"field": "boxEnd"},
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#F8EBF3"
          },
          "value": "#E5F2FA"
        },
        "stroke": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#CC79A7"
          },
          "value": "#0072B2"
        }
      }
    },
    {
      "data": {
        "values": [
          {"state": "NSW", "ruleStart": 11.85, "ruleEnd": 12.45},
          {"state": "VIC", "ruleStart": 1.75, "ruleEnd": 3}
        ]
      },
      "mark": {"type": "rule", "strokeWidth": 1.7},
      "encoding": {
        "x": {"field": "ruleStart", "type": "quantitative"},
        "x2": {"field": "ruleEnd"},
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#CC79A7"
          },
          "value": "#0072B2"
        }
      }
    },
    {
      "data": {
        "values": [
          {"state": "NSW", "pointX": 11.85},
          {"state": "VIC", "pointX": 1.75}
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-left",
        "filled": true,
        "size": 72
      },
      "encoding": {
        "x": {"field": "pointX", "type": "quantitative"},
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#CC79A7"
          },
          "value": "#0072B2"
        }
      }
    },
    {
      "data": {
        "values": [
          {"state": "NSW", "labelX": 12.8, "label": "11 > other four (8)"},
          {"state": "VIC", "labelX": 3.4, "label": "Phillip Island only"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "x": {"field": "labelX", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "Arial", "titleFont": "Arial"}
  }
}
