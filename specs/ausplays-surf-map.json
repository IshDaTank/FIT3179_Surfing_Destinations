{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    }
  },
  "description": "Proportional symbol map for estimated people aged 15+ who surfed in 2025, by Australian state or territory. ACT has no coastline; its symbol represents residents, not a surf site.",
  "usermeta": {
    "title": "Where Are Australia’s Surfers?",
    "analysis": "New South Wales is home to the largest estimated adult surfing population (117,953), accounting for around 38% of the total across the eight jurisdictions. Queensland (63,787), Victoria (58,683) and Western Australia (43,496) follow. These figures indicate where surfers live, not where surfing occurs. The different pattern in participation rates—with WA at 1.76% and NSW at 1.67%—shows why population size matters when interpreting the map. AusPlay figures are survey estimates, and small differences should not be treated as definitive.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ],
    "annotation": "NSW has the largest estimated adult surfing population: 117,953 participants.",
    "sizeLegendValues": [
      0,
      25000,
      50000,
      75000,
      100000
    ],
    "sizeLegendTitle": "Estimated surfers aged 15+"
  },
  "height": 565,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36 || datum.id == \"036\""
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eef5f3",
        "stroke": "#a6bcbc",
        "strokeWidth": 1.35,
        "clip": false
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_map_2025.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.83,
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "participants",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              120000
            ],
            "range": [
              36,
              2600
            ]
          },
          "legend": null
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "QLD",
              "VIC",
              "WA",
              "SA",
              "TAS",
              "ACT",
              "NT"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73",
              "#7B61A8",
              "#8C6D31",
              "#666666"
            ]
          },
          "legend": {
            "title": "State / territory",
            "orient": "bottom",
            "columns": 4,
            "symbolSize": 190,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelFontSize": 13,
            "columnPadding": 18,
            "rowPadding": 12,
            "labelLimit": 150,
            "offset": 17
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "participants",
            "title": "Estimated participants aged 15+",
            "format": ","
          },
          {
            "field": "participation_rate_pct",
            "title": "Adult participation rate",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_map_2025.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "dy": -14,
        "color": "#204551"
      },
      "encoding": {
        "longitude": {
          "field": "longitude"
        },
        "latitude": {
          "field": "latitude"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ],
  "padding": {
    "left": 20,
    "right": 28,
    "top": 25,
    "bottom": 42
  }
}
