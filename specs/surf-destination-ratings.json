{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Interactive ranked dot plot of selected Australian surf breaks, comparing visitor-rated wave quality, consistency and overall rating, with state and vote-count filters.",
  "background": "#ffffff",
  "width": "container",
  "height": 480,
  "data": {
    "url": "data/surf_break_ratings_2026.csv",
    "format": {
      "type": "csv"
    }
  },
  "usermeta": {
    "title": "Which Australian Surf Breaks Receive the Strongest Ratings?",
    "annotation": "Snapper Rocks leads Burleigh Heads in wave quality (4.9 vs 4.5), but Burleigh scores higher for consistency (4.2 vs 3.9). The best-rated waves are not necessarily the most reliable.",
    "analysis": "The ratings reveal an important distinction between wave quality under favourable conditions and how consistently those conditions occur. Snapper Rocks scores 4.9/5 for wave quality, ahead of Burleigh Heads at 4.5/5. However, this relationship reverses for consistency, where Burleigh scores 4.2/5 compared with Snapper Rocks at 3.9/5. A break therefore cannot be evaluated using wave quality alone: exceptionally rated waves may occur less consistently than those at another destination. The interactive controls allow readers to examine how the ranking changes by rating dimension and state. The minimum-vote filter adds a further consideration, as locations such as Kirra and Shipstern Bluff receive extremely high quality ratings but have comparatively few recorded votes. Removing the vote threshold reveals these highly rated breaks, while increasing it restricts the comparison to destinations with more reported feedback. Consequently, the visualisation should be interpreted as a comparison of visitor perceptions for 21 selected surf breaks, rather than a definitive ranking of all Australian surfing destinations. Ratings are subjective, and the reported site vote counts are not separate sample sizes for each rating dimension.",
    "sources": [
      {
        "label": "Surf-Forecast · Australian surf-break visitor ratings (accessed October 2026)",
        "url": "https://www.surf-forecast.com/countries/Australia/breaks"
      }
    ]
  },
  "params": [
    {
      "name": "metricChoice",
      "value": "quality",
      "bind": {
        "input": "select",
        "options": [
          "quality",
          "consistency",
          "overall"
        ],
        "labels": [
          "Wave quality (good day)",
          "Surf consistency",
          "Overall rating"
        ],
        "name": "Rating measure: "
      }
    },
    {
      "name": "stateChoice",
      "value": "All states",
      "bind": {
        "input": "select",
        "options": [
          "All states",
          "NSW",
          "QLD",
          "VIC",
          "WA",
          "SA",
          "TAS"
        ],
        "labels": [
          "All states",
          "New South Wales",
          "Queensland",
          "Victoria",
          "Western Australia",
          "South Australia",
          "Tasmania"
        ],
        "name": "State: "
      }
    },
    {
      "name": "minVotes",
      "value": 5,
      "bind": {
        "input": "select",
        "options": [
          0,
          5,
          10,
          15
        ],
        "labels": [
          "All vote counts",
          "At least 5",
          "At least 10",
          "At least 15"
        ],
        "name": "Vote threshold: "
      }
    }
  ],
  "transform": [
    {
      "filter": "stateChoice === 'All states' || datum.state === stateChoice"
    },
    {
      "filter": "toNumber(datum.votes) >= minVotes"
    },
    {
      "calculate": "metricChoice === 'quality' ? toNumber(datum.quality) : metricChoice === 'consistency' ? toNumber(datum.consistency) : toNumber(datum.overall)",
      "as": "score"
    },
    {
      "calculate": "datum.break + ' (' + datum.state + ')'",
      "as": "break_state"
    }
  ],
  "encoding": {
    "y": {
      "field": "break_state",
      "type": "nominal",
      "sort": {
        "field": "score",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": "Australian surf breaks",
        "titleFontSize": 13,
        "titlePadding": 12,
        "labelFontSize": 12,
        "labelLimit": 235,
        "labelPadding": 8,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          5.35
        ],
        "nice": false
      },
      "axis": {
        "title": "Visitor rating (out of 5)",
        "values": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "grid": true,
        "gridColor": "#e4eeec",
        "titleFontSize": 13,
        "labelFontSize": 12,
        "labelPadding": 7
      }
    },
    "tooltip": [
      {
        "field": "break",
        "type": "nominal",
        "title": "Surf break"
      },
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "score",
        "type": "quantitative",
        "title": "Selected rating / 5",
        "format": ".1f"
      },
      {
        "field": "quality",
        "type": "quantitative",
        "title": "Wave quality / 5",
        "format": ".1f"
      },
      {
        "field": "consistency",
        "type": "quantitative",
        "title": "Consistency / 5",
        "format": ".1f"
      },
      {
        "field": "overall",
        "type": "quantitative",
        "title": "Overall rating / 5",
        "format": ".1f"
      },
      {
        "field": "votes",
        "type": "quantitative",
        "title": "Site votes reported",
        "format": ",.0f"
      },
      {
        "field": "url",
        "type": "nominal",
        "title": "Rating source"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a3c4c4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "score"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 175,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "QLD",
              "VIC",
              "WA",
              "SA",
              "TAS"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73",
              "#7B61A8"
            ]
          },
          "legend": {
            "title": "State",
            "orient": "top",
            "direction": "horizontal",
            "symbolSize": 170,
            "labelFontSize": 13,
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "columnPadding": 16,
            "offset": 12
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f"
    },
    "font": "Arial"
  },
  "padding": {
    "left": 8,
    "right": 28,
    "top": 12,
    "bottom": 12
  }
}
