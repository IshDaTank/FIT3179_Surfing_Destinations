{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Mirrored bar comparison of estimated adult female and male surfing participants by jurisdiction in 2025. NT omitted from subgroup display.",
  "background": "#ffffff",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/ausplay-surf-gender-2025.csv"
  },
  "usermeta": {
    "title": "Who Surfs in Australia?",
    "annotation": "NSW has the largest estimated number of both male (74,892) and female (43,061) adult surfers.",
    "analysis": "Men have higher estimated adult surfing participant counts than women in all seven jurisdictions shown. NSW leads both groups, with 74,892 male and 43,061 female participants. However, the composition varies: women account for approximately 43% of Victoria’s combined male and female estimates, compared with approximately 35% in Western Australia. These figures reflect residence-based survey estimates, not surfing frequency or destination visits. The Northern Territory is excluded because the published female subgroup estimate is zero, which does not establish that no women surf there.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "transform": [
    {
      "filter": "isValid(datum.state) && datum.state != null && datum.state != '' && datum.state != 'NT'"
    },
    {
      "calculate": "datum.sex === 'Women' ? -toNumber(datum.estimated_participants) : toNumber(datum.estimated_participants)",
      "as": "signed_value"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "ordinal",
      "sort": [
        "NSW",
        "QLD",
        "VIC",
        "WA",
        "SA",
        "TAS",
        "ACT"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "signed_value",
      "type": "quantitative",
      "scale": {
        "domain": [
          -85000,
          85000
        ],
        "nice": false
      },
      "axis": {
        "title": "Estimated adult surfers (15+) · 2025",
        "labelExpr": "format(abs(datum.value), \",.0f\")",
        "tickCount": 9,
        "grid": true,
        "labelFontSize": 12,
        "titleFontSize": 13,
        "labelPadding": 8
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State / territory"
      },
      {
        "field": "sex",
        "title": "Gender category"
      },
      {
        "field": "estimated_participants",
        "title": "Estimated participants",
        "format": ",.0f"
      },
      {
        "field": "year",
        "title": "Year"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 23,
        "cornerRadius": 3
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Women",
              "Men"
            ],
            "range": [
              "#CC79A7",
              "#0072B2"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "labelFontSize": 14,
            "symbolSize": 220,
            "symbolType": "square",
            "labelPadding": 9,
            "columnPadding": 35,
            "offset": 16
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Women' && datum.estimated_participants > 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -9,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "estimated_participants",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Men' && datum.estimated_participants > 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "estimated_participants",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    },
    "font": "Arial"
  },
  "padding": {
    "left": 10,
    "right": 40,
    "top": 10,
    "bottom": 14
  }
}
