{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Marimekko chart of Australian adult surfing participation by gender.",
  "background": "#ffffff",
  "data": {
    "url": "data/ausplay-surf-mosaic-2025.csv",
    "format": {
      "type": "csv"
    }
  },
  "usermeta": {
    "title": "Who Makes Up Australia’s Surfing Community?",
    "annotation": "ACT has the closest estimated gender balance (46.9% women), while WA has the lowest female share (34.7%) — a 12.2 percentage-point difference.",
    "analysis": "The chart combines two comparisons at once. Column width represents each state or territory’s share of the combined published male and female surfing estimates, while the height of each coloured segment shows the gender composition within that jurisdiction. New South Wales contributes the largest surfing population overall, which is why its column is widest, but the most distinctive compositional result is the contrast between the ACT and Western Australia. The ACT has the closest estimated gender balance, with women making up 46.9% of participants, whereas WA has the lowest female share at 34.7%. Victoria also stands out with a comparatively high estimated female share (43.2%), showing that states can differ not only in the size of their surfing communities but also in their internal composition. The chart therefore highlights both scale and structure within Australia’s surfing population.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025 state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "width": "container",
  "height": 430,
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 1.8
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100],
            "nice": false
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100],
            "nice": false
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": ["Men", "Women"],
            "range": ["#0072B2", "#CC79A7"]
          },
          "legend": {
            "title": "Gender",
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 220,
            "labelFontSize": 15,
            "titleFontSize": 15,
            "titleFontWeight": "bold",
            "offset": 14,
            "columnPadding": 28
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "sex",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ",.0f"
          },
          {
            "field": "gender_share_pct",
            "type": "quantitative",
            "title": "Share within state (%)",
            "format": ".1f"
          },
          {
            "field": "state_total",
            "type": "quantitative",
            "title": "Combined male/female total",
            "format": ",.0f"
          },
          {
            "field": "national_share_pct",
            "type": "quantitative",
            "title": "Share of displayed total (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Women' && datum.state !== 'TAS' && datum.state !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#173946",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },
        "y": {
          "field": "ymid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },
        "text": {
          "field": "gender_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.sex === 'Men' && datum.state !== 'TAS' && datum.state !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ffffff",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },
        "y": {
          "field": "ymid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },
        "text": {
          "field": "gender_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "font": "Arial"
  },
  "padding": {
    "left": 12,
    "right": 12,
    "top": 8,
    "bottom": 8
  }
}
