{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Mirrored bar comparison of estimated adult female and male surfing participants by jurisdiction in 2025.",
  "background": "#ffffff",
  "width": "container",
  "height": 410,
  "data": {
    "url": "data/ausplay-surf-gender-2025.csv"
  },
  "usermeta": {
    "title": "Who Surfs in Australia?",
    "annotation": "NSW has the largest estimated surfing population among both men (74,892) and women (43,061).",
    "analysis": "Men outnumber women in estimated adult surfing participation across all eight states and territories. New South Wales leads both groups, while Queensland and Victoria form a clear second tier. The chart also shows that the gender balance differs by state: women make up a comparatively larger share of surfers in Victoria than in Western Australia, suggesting that Australia’s surfing population is not only uneven in size but also different in composition from one jurisdiction to another. NSW’s dominance in both groups reinforces the scale of its surfing community within the national picture.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "transform": [
    {
      "filter": "isValid(datum.state) && datum.state != null && datum.state != ''"
    },
    {
      "calculate": "datum.sex === 'Women' ? -datum.estimated_participants : datum.estimated_participants",
      "as": "signed_value"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "ordinal",
      "sort": ["NSW", "QLD", "VIC", "WA", "SA", "TAS", "ACT", "NT"],
      "axis": {
        "title": null,
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "signed_value",
      "type": "quantitative",
      "scale": {
        "domain": [-82000, 82000]
      },
      "axis": {
        "title": "Estimated adult surfing participants (15+), 2025",
        "labelExpr": "format(abs(datum.value), ',.0f')",
        "values": [-80000, -60000, -40000, -20000, 0, 20000, 40000, 60000, 80000],
        "grid": true,
        "labelFontSize": 12,
        "titleFontSize": 13,
        "labelPadding": 8
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State / territory"
      },
      {
        "field": "sex",
        "title": "Gender category"
      },
      {
        "field": "estimated_participants",
        "title": "Estimated participants",
        "format": ",.0f"
      },
      {
        "field": "year",
        "title": "Year"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 23,
        "cornerRadius": 3
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": ["Women", "Men"],
            "range": ["#CC79A7", "#0072B2"]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "labelFontSize": 14,
            "symbolSize": 220,
            "symbolType": "square",
            "labelPadding": 9,
            "columnPadding": 35,
            "offset": 16
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === 'NSW' && datum.sex === 'Women'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "estimated_participants",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === 'NSW' && datum.sex === 'Men'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "estimated_participants",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    },
    "font": "Arial"
  },
  "padding": {
    "left": 6,
    "right": 22,
    "top": 4,
    "bottom": 12
  }
}
