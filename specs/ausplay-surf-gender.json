{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Mirrored bar chart showing estimated adult surfing participants by gender across seven Australian states and territories, using AusPlay 2025 data.",
  "background": "#ffffff",
  "width": "container",
  "height": 415,
  "data": {
    "url": "data/ausplay-surf-gender-2025.csv",
    "format": {
      "type": "csv"
    }
  },
  "usermeta": {
    "title": "Who Surfs in Australia?",
    "annotation": "NSW has the largest estimated surfing population among both men (74,892) and women (43,061).",
    "analysis": "Men outnumber women among estimated adult surfing participants in all seven jurisdictions shown. NSW leads both groups, reflecting its substantial surfing population, but absolute numbers only tell part of the story. Women account for approximately 43% of Victoria's combined male and female estimates, compared with about 35% in Western Australia, suggesting differences in the demographic composition of surfing participation across states. This distinction is important because a large surfing population does not necessarily imply an equally broad participation base across demographic groups. Figures represent residents aged 15 and over who surfed at least once during 2025, not surfing frequency or attendance at individual beaches. The Northern Territory is omitted because its published female subgroup estimate is zero; this should not be interpreted as evidence that no women surf there. Small subgroup estimates should be interpreted cautiously.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025 state and territory data tables (released 30 April 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "transform": [
    {
      "calculate": "datum.sex === 'Women' ? -datum.estimated_participants : datum.estimated_participants",
      "as": "signed_value"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "ordinal",
      "sort": [
        "NSW",
        "QLD",
        "VIC",
        "WA",
        "SA",
        "TAS",
        "ACT"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "signed_value",
      "type": "quantitative",
      "scale": {
        "domain": [
          -85000,
          85000
        ],
        "nice": false,
        "zero": true
      },
      "axis": {
        "title": "Estimated adult surfing participants (15+), 2025",
        "labelExpr": "format(abs(datum.value), ',.0f')",
        "values": [
          -80000,
          -60000,
          -40000,
          -20000,
          0,
          20000,
          40000,
          60000,
          80000
        ],
        "grid": true,
        "gridColor": "#e4eeec",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "labelPadding": 8,
        "titlePadding": 16
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "ordinal",
        "title": "State / territory"
      },
      {
        "field": "sex",
        "type": "nominal",
        "title": "Gender"
      },
      {
        "field": "estimated_participants",
        "type": "quantitative",
        "title": "Estimated participants",
        "format": ",.0f"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 25,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Women",
              "Men"
            ],
            "range": [
              "#CC79A7",
              "#0072B2"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "symbolSize": 220,
            "symbolType": "square",
            "labelPadding": 9,
            "columnPadding": 35,
            "offset": 18
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "position": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#80999e",
        "strokeWidth": 1.2,
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === 'NSW' && datum.sex === 'Women'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "estimated_participants",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === 'NSW' && datum.sex === 'Men'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "estimated_participants",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "font": "Arial",
    "text": {
      "font": "Arial"
    }
  },
  "padding": {
    "left": 10,
    "right": 35,
    "top": 10,
    "bottom": 16
  }
}
