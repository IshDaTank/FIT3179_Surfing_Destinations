        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 5,
        "fillOpacity": 0,
        "stroke": "#D47439",
        "strokeWidth": 2.7
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan", "Feb", "Mar", "Apr",
            "May", "Jun", "Jul", "Aug",
            "Sep", "Oct", "Nov", "Dec"
          ]
        },
        "y": {
          "field": "year",
          "type": "ordinal",
          "sort": [2022, 2023, 2024, 2025]
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan", "Feb", "Mar", "Apr",
            "May", "Jun", "Jul", "Aug",
            "Sep", "Oct", "Nov", "Dec"
          ]
        },
        "y": {
          "field": "year",
          "type": "ordinal",
          "sort": [2022, 2023, 2024, 2025]
        },
        "text": {
          "field": "median_hs",
          "type": "quantitative",
          "format": ".2f"
        },
        "color": {
