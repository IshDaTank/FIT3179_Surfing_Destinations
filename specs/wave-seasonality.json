            "title": "Year"
          },
          {
            "field": "month",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "median_hs",
            "type": "quantitative",
            "format": ".2f",
            "title": "Median Hs (m)"
          },
          {
            "field": "valid_readings",
            "type": "quantitative",
            "title": "Valid readings"
          },
          {
            "field": "coverage_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Coverage (%)"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
