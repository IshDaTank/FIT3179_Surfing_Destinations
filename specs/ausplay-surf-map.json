{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Australian surfing participation bubble map with horizontal legends underneath.",
  "usermeta": {
    "title": "Where Are Australia’s Surfers?",
    "annotation": "NSW leads Australia with 117,953 estimated adult surfing participants in 2025.",
    "analysis": "New South Wales contains the largest estimated adult surfing population in Australia (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). This pattern highlights how strongly Australia’s surfing community is concentrated in the larger eastern coastal states, while still maintaining a clear national footprint across all eight states and territories. Western Australia stands out as a substantial surfing population centre despite its greater distance from the dense east-coast corridor, reinforcing the breadth of Australia’s surfing identity.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "background": "#ffffff",
  "spacing": 10,
  "vconcat": [
    {
      "description": "Main Australian bubble map, retaining state colours and geographic locations.",
      "width": "container",
      "height": 500,
      "projection": {
        "type": "mercator"
      },
      "padding": {
        "left": 12,
        "right": 24,
        "top": 18,
        "bottom": 28
      },
      "layer": [
        {
          "data": {
            "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
            "format": {
              "type": "topojson",
              "feature": "countries"
            }
          },
          "transform": [
            {
              "filter": "datum.id == 36 || datum.id == '036'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#eef5f3",
            "stroke": "#a6bcbc",
            "strokeWidth": 1.35
          }
        },
        {
          "data": {
            "url": "data/ausplay_surf_map_2025.csv"
          },
          "mark": {
            "type": "circle",
            "opacity": 0.86,
            "stroke": "#ffffff",
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "participants",
              "type": "quantitative",
              "scale": {
                "domain": [0, 125000],
                "range": [36, 3000]
              },
              "legend": null
            },
            "color": {
              "field": "state",
              "type": "nominal",
              "scale": {
                "domain": [
                  "NSW",
                  "QLD",
                  "VIC",
                  "WA",
                  "SA",
                  "TAS",
                  "ACT",
                  "NT"
                ],
                "range": [
                  "#0072B2",
                  "#E69F00",
                  "#CC79A7",
                  "#D55E00",
                  "#009E73",
                  "#7B61A8",
                  "#8C6D31",
                  "#666666"
                ]
              },
              "legend": {
                "title": "State / territory",
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 4,
                "symbolSize": 200,
                "titleFontSize": 14,
                "titleFontWeight": "bold",
                "labelFontSize": 13,
                "columnPadding": 18,
                "rowPadding": 12,
                "offset": 16
              }
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State / territory"
              },
              {
                "field": "participants",
                "title": "Estimated participants aged 15+",
                "format": ",.0f"
              },
              {
                "field": "participation_rate_pct",
                "title": "Adult participation rate (%)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/ausplay_surf_map_2025.csv"
          },
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#204551"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "state"
            },
            "yOffset": {
              "value": -16
            }
          }
        }
      ]
    },
    {
      "description": "Custom horizontal bubble-size legend placed below the state legend. Circle areas use the same scale as the map.",
      "title": {
        "text": "Estimated surfers aged 15+",
        "anchor": "start",
        "font": "Arial",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#244654",
        "offset": 9
      },
      "width": "container",
      "height": 110,
      "data": {
        "values": [
          {
            "index": 0,
            "participants": 0,
            "label": "0"
          },
          {
            "index": 1,
            "participants": 25000,
            "label": "25,000"
          },
          {
            "index": 2,
            "participants": 50000,
            "label": "50,000"
          },
          {
            "index": 3,
            "participants": 75000,
            "label": "75,000"
          },
          {
            "index": 4,
            "participants": 100000,
            "label": "100,000"
          },
          {
            "index": 5,
            "participants": 125000,
            "label": "125,000"
          }
        ]
      },
      "layer": [
        {
          "description": "Six circles representing increasing participant counts.",
          "mark": {
            "type": "circle",
            "filled": true,
            "color": "#6798a1",
            "stroke": "#35626d",
            "strokeWidth": 1.2,
            "opacity": 0.95
          },
          "encoding": {
            "x": {
              "field": "index",
              "type": "quantitative",
              "scale": {
                "domain": [-0.55, 5.55],
                "nice": false
              },
              "axis": null
            },
            "y": {
              "datum": 67,
              "type": "quantitative",
              "scale": {
                "domain": [0, 110],
                "nice": false
              },
              "axis": null
            },
            "size": {
              "field": "participants",
              "type": "quantitative",
              "scale": {
                "domain": [0, 125000],
                "range": [36, 3000]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "participants",
                "type": "quantitative",
                "title": "Estimated surfers aged 15+",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "description": "Numeric labels displayed directly below the corresponding bubbles.",
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#31535f",
            "align": "center",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "field": "index",
              "type": "quantitative",
              "scale": {
                "domain": [-0.55, 5.55],
                "nice": false
              },
              "axis": null
            },
            "y": {
              "datum": 15,
              "type": "quantitative",
              "scale": {
                "domain": [0, 110],
                "nice": false
              },
              "axis": null
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    },
    "font": "Arial"
  }
}
