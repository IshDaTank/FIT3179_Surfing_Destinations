{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Australian surfing participation map with a separate boxed legend panel beneath the map. The size legend runs horizontally and the chart is sized to fit within the dashboard card without horizontal scrolling.",
  "usermeta": {
    "title": "Where Are Australia’s Surfers?",
    "annotation": "NSW leads Australia with 117,953 estimated adult surfing participants in 2025.",
    "analysis": "New South Wales contains the largest estimated adult surfing population in Australia (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). This pattern highlights how strongly Australia’s surfing community is concentrated in the larger eastern coastal states, while still maintaining a clear national footprint across all eight states and territories. Western Australia stands out as a substantial surfing population centre despite its greater distance from the dense east-coast corridor, reinforcing the breadth of Australia’s surfing identity.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "background": "transparent",
  "spacing": 12,
  "vconcat": [
    {
      "description": "Main map with state bubbles and labels. Automatic legends are disabled because custom legends are drawn below in a separate box.",
      "width": 760,
      "height": 470,
      "projection": {
        "type": "mercator"
      },
      "padding": {
        "left": 10,
        "right": 10,
        "top": 10,
        "bottom": 0
      },
      "layer": [
        {
          "description": "Australian land outline.",
          "data": {
            "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
            "format": {
              "type": "topojson",
              "feature": "countries"
            }
          },
          "transform": [
            {
              "filter": "datum.id == 36 || datum.id == '036'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#eef5f3",
            "stroke": "#a8bec0",
            "strokeWidth": 1.4
          }
        },
        {
          "description": "State and territory bubbles sized by estimated surfers aged 15+.",
          "data": {
            "url": "data/ausplay_surf_map_2025.csv"
          },
          "mark": {
            "type": "circle",
            "opacity": 0.86,
            "stroke": "#ffffff",
            "strokeWidth": 1.6
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "participants",
              "type": "quantitative",
              "scale": {
                "domain": [0, 125000],
                "range": [36, 3000]
              },
              "legend": null
            },
            "color": {
              "field": "state",
              "type": "nominal",
              "scale": {
                "domain": [
                  "NSW",
                  "QLD",
                  "VIC",
                  "WA",
                  "SA",
                  "TAS",
                  "ACT",
                  "NT"
                ],
                "range": [
                  "#0072B2",
                  "#E69F00",
                  "#CC79A7",
                  "#D55E00",
                  "#009E73",
                  "#7B61A8",
                  "#8C6D31",
                  "#666666"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State / territory"
              },
              {
                "field": "participants",
                "type": "quantitative",
                "title": "Estimated surfers aged 15+",
                "format": ",.0f"
              },
              {
                "field": "participation_rate_pct",
                "type": "quantitative",
                "title": "Adult participation rate (%)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "description": "State abbreviations positioned over the bubbles.",
          "data": {
            "url": "data/ausplay_surf_map_2025.csv"
          },
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#234957"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "state",
              "type": "nominal"
            }
          }
        }
      ],
      "config": {
        "view": {
          "stroke": null
        }
      }
    },

    {
