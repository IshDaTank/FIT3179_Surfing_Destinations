{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bubble map of estimated adult surfing participants by Australian state and territory in 2025.",
  "background": "#ffffff",
  "width": "container",
  "height": 500,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    },
    "font": "Arial"
  },
  "usermeta": {
    "title": "Where Are Australia’s Surfers?",
    "analysis": "New South Wales contains the largest estimated adult surfing population in Australia (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). This pattern highlights how strongly Australia’s surfing community is concentrated in the larger eastern coastal states, while still maintaining a clear national footprint across all eight states and territories. Western Australia stands out as a substantial surfing population centre despite its greater distance from the dense east-coast corridor, reinforcing the breadth of Australia’s surfing identity.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ],
    "annotation": "NSW leads Australia with 117,953 estimated adult surfing participants in 2025."
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36 || datum.id == '036'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eef5f3",
        "stroke": "#a6bcbc",
        "strokeWidth": 1.35
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_map_2025.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.86,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "participants",
          "type": "quantitative",
          "scale": {
            "domain": [0, 125000],
            "range": [36, 3000]
          },
          "legend": {
            "title": "Estimated surfers aged 15+",
            "format": ",.0f",
            "values": [0, 25000, 50000, 75000, 100000, 125000],
            "labelFontSize": 14,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelPadding": 8,
            "symbolStrokeColor": "#35626d",
            "symbolFillColor": "#5c959e",
            "symbolOpacity": 0.95,
            "offset": 14,
            "orient": "bottom-right"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "QLD", "VIC", "WA", "SA", "TAS", "ACT", "NT"],
            "range": ["#0072B2", "#E69F00", "#CC79A7", "#D55E00", "#009E73", "#7B61A8", "#8C6D31", "#666666"]
          },
          "legend": {
            "title": "State / territory",
            "orient": "bottom",
            "columns": 4,
            "symbolSize": 200,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelFontSize": 13,
            "columnPadding": 18,
            "rowPadding": 12,
            "offset": 16
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "participants",
            "title": "Estimated participants aged 15+",
            "format": ",.0f"
          },
          {
            "field": "participation_rate_pct",
            "title": "Adult participation rate (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_map_2025.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#204551"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        },
        "yOffset": {
          "value": -16
        }
      }
    }
  ],
  "padding": {
    "left": 12,
    "right": 24,
    "top": 18,
    "bottom": 28
  }
}
