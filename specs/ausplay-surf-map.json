{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Rank Australian states and territories by estimated adult surfing participation count or participation rate.",
  "background": "#ffffff",
  "width": "container",
  "height": 340,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    },
    "font": "Arial"
  },
  "usermeta": {
    "title": "Which States Lead in Surfing Participation?",
    "defaultMetric": "count",
    "metricOptions": [
      {
        "value": "count",
        "label": "Estimated participants",
        "unit": "people"
      },
      {
        "value": "rate",
        "label": "Adult participation rate",
        "unit": "%"
      }
    ],
    "interpretations": {
      "count": "New South Wales leads in estimated adult surfers (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). The ranking shows a clear concentration in the two largest east-coast surfing states, while South Australia, Tasmania, the ACT and the Northern Territory form a much smaller second tier. This structure suggests that surfing participation is nationally distributed but strongly anchored in a few major population centres.",
      "rate": "Western Australia ranks first in adult surfing participation rate (1.76%), narrowly ahead of New South Wales (1.67%). Queensland (1.38%) and Tasmania (1.36%) follow. Once population size is taken into account, the ranking changes noticeably: WA rises from fourth by total volume to first by rate, indicating that surfing forms a particularly strong part of everyday sporting participation there."
    },
    "highlights": {
      "count": "NSW leads by volume: 117,953 estimated adult surfers.",
      "rate": "WA leads by participation rate: 1.76% of adults."
    },
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "data": {
    "url": "data/ausplay_surf_ranking_2025.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "metric",
        "equal": "count"
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": ["NSW", "QLD", "VIC", "WA", "SA", "TAS", "ACT", "NT"],
      "axis": {
        "title": null,
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 10
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "domain": [0, 125000],
        "nice": false,
        "zero": true
      },
      "axis": {
        "title": "Estimated adult surfing participants (people)",
        "grid": true,
        "labelFontSize": 12,
        "titleFontSize": 13,
        "values": [0, 25000, 50000, 75000, 100000, 125000],
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State / territory"
      },
      {
        "field": "participants",
        "title": "Estimated participants",
        "format": ",.0f"
      },
      {
        "field": "participation_rate_pct",
        "title": "Participation rate (%)",
        "format": ".2f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#9bb9bb",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "value"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 190,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "QLD", "VIC", "WA", "SA", "TAS", "ACT", "NT"],
            "range": ["#0072B2", "#E69F00", "#CC79A7", "#D55E00", "#009E73", "#7B61A8", "#8C6D31", "#666666"]
          },
          "legend": {
            "title": "State / territory",
            "orient": "top-right",
            "direction": "vertical",
            "symbolSize": 180,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "labelFontSize": 13,
            "offset": 8,
            "padding": 6
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#244654"
      },
      "encoding": {
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    }
  ],
  "padding": {
    "left": 8,
    "right": 20,
    "top": 10,
    "bottom": 10
  }
}
