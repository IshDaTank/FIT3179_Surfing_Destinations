{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Interactive map of 12 non-cancelled 2026 World Surf League Championship Tour locations, highlighting the three Australian stops.",
  "background": "#ffffff",
  "width": "container",
  "height": 485,
  "usermeta": {
    "title": "Where Does Australia Feature on the World Surfing Tour?",
    "annotation": "Australia hosts the opening three stops of the 2026 Championship Tour: Bells Beach, Margaret River and Snapper Rocks. Together, they account for 3 of the 12 non-cancelled stops shown on the revised calendar.",
    "analysis": "The Championship Tour provides a different perspective on Australia's international surfing significance. Rather than examining surfing destinations through visitor ratings, it reveals where elite professional competitions are held. Australia hosts the first three stops of the revised 2026 calendar: Bells Beach in Victoria, Margaret River in Western Australia and Snapper Rocks in Queensland. These represent 25% of the 12 non-cancelled stops mapped. Their locations also demonstrate the geographic diversity of Australia's professional surfing venues, stretching across its eastern, southern and western coasts. Beyond Australia, the tour continues across New Zealand, the Americas, the Pacific, Europe and Asia, highlighting surfing's international reach. The numbered points represent the published order of events, not travel routes or rankings of surf quality. The map uses approximate venue coordinates, and it reflects the revised schedule rather than the original tour announcement.",
    "sources": [
      {
        "label": "2026 Championship Tour calendar",
        "url": "https://www.fantasysurfingleague.com/en/events/?season=2026"
      },
      {
        "label": "Surfing New Zealand · Raglan calendar change",
        "url": "https://surfingnz.co.nz/latest/19681/"
      },
      {
        "label": "2026 Championship Tour · Philippines addition",
        "url": "https://sdmisports.com/news/world-surf-league-adds-cloud-9-philippines-to-2026-championship-tour-lineup"
      },
      {
        "label": "World Atlas · Geographic boundaries",
        "url": "https://github.com/topojson/world-atlas"
      }
    ]
  },
  "params": [
    {
      "name": "hostChoice",
      "value": "All locations",
      "bind": {
        "input": "select",
        "options": [
          "All locations",
          "Australia",
          "International"
        ],
        "labels": [
          "All locations",
          "Australia only",
          "International only"
        ],
        "name": "Event location: "
      }
    },
    {
      "name": "phaseChoice",
      "value": "All events",
      "bind": {
        "input": "select",
        "options": [
          "All events",
          "Regular season",
          "Postseason"
        ],
        "labels": [
          "All events",
          "Regular season",
          "Postseason"
        ],
        "name": "Competition stage: "
      }
    }
  ],
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "description": "World geography provides spatial context for the Championship Tour.",
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9f1ef",
        "stroke": "#ffffff",
        "strokeWidth": 0.75
      }
    },
    {
      "description": "Event markers, coloured according to whether a stop is in Australia.",
      "data": {
        "url": "data/wsl-2026-tour-locations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "stop": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "hostChoice === 'All locations' || datum.host_group === hostChoice"
        },
        {
          "filter": "phaseChoice === 'All events' || datum.phase === phaseChoice"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 600,
        "opacity": 0.96,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "host_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australia",
              "International"
            ],
            "range": [
              "#0072B2",
              "#D55E00"
            ]
          },
          "legend": {
            "title": "Event location",
            "orient": "top",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "circle",
            "symbolSize": 210,
            "labelFontSize": 13,
            "labelColor": "#244654",
            "labelLimit": 230,
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "titleColor": "#244654",
            "columnPadding": 22,
            "rowPadding": 8,
            "offset": 15,
            "labelExpr": "datum.label === 'Australia' ? 'Australia (3 stops)' : 'International (9 stops)'"
          }
        },
        "tooltip": [
          {
            "field": "stop",
            "type": "quantitative",
            "title": "Tour stop",
            "format": ".0f"
          },
          {
            "field": "event",
            "type": "nominal",
            "title": "Competition"
          },
          {
            "field": "location",
            "type": "nominal",
            "title": "Surf break"
          },
          {
            "field": "country",
            "type": "nominal",
            "title": "Host country"
          },
          {
            "field": "date_window",
            "type": "nominal",
            "title": "Event window"
          },
          {
            "field": "phase",
            "type": "nominal",
            "title": "Competition stage"
          }
        ]
      }
    },
    {
      "description": "Number labels inside markers show the chronological order of the events.",
      "data": {
        "url": "data/wsl-2026-tour-locations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "stop": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "hostChoice === 'All locations' || datum.host_group === hostChoice"
        },
        {
          "filter": "phaseChoice === 'All events' || datum.phase === phaseChoice"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "stop",
          "type": "quantitative",
          "format": ".0f"
        },
        "tooltip": [
          {
            "field": "stop",
            "type": "quantitative",
            "title": "Tour stop",
            "format": ".0f"
          },
          {
            "field": "event",
            "type": "nominal",
            "title": "Competition"
          },
          {
            "field": "location",
            "type": "nominal",
            "title": "Surf break"
          },
          {
            "field": "country",
            "type": "nominal",
            "title": "Host country"
          },
          {
            "field": "date_window",
            "type": "nominal",
            "title": "Event window"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "legend": {
      "labelColor": "#31535f",
      "titleColor": "#244654",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "padding": {
    "left": 8,
    "right": 8,
    "top": 12,
    "bottom": 12
  }
}
