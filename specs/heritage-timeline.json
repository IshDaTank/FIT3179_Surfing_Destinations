            "direction": "down",
            "phase": "early"
          },
          {
            "year": 2013,
            "arrowY": 16.8,
            "direction": "down",
            "phase": "middle"
          },
          {
            "year": 2022,
            "arrowY": 18.3,
            "direction": "up",
            "phase": "late"
          }
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "arrowY", "type": "quantitative"},
        "shape": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": ["down", "up"],
            "range": ["triangle-down", "triangle-up"]
          },
          "legend": null
        },
        "color": {
          "field": "phase",
          "type": "nominal",
          "scale": {
            "domain": ["early", "middle", "late"],
            "range": ["#0072B2", "#009E73", "#D55E00"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2008.55,
            "y": 11.8,
            "label": "8 in NSW by 2009"
          },
          {
            "x": 2013.25,
            "y": 20.3,
            "label": "16 across 5 states"
          },
          {
            "x": 2021.95,
            "y": 14,
            "label": "19th: Norah Head"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 12,
        "color": "#214653",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
