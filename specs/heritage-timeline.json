{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Cumulative step-line chart showing 19 Australian National Surfing Reserve dedications from 2006 to 2022, with three milestone annotations.",
  "usermeta": {
    "title": "When Did Australia's Surfing Reserves Gain Recognition?",
    "analysis": "The recognition timeline rises quickly during its early years: Maroubra became the first National Surfing Reserve in 2006, and eight NSW locations had been dedicated by the end of 2009. Another eight were added from 2010 to 2013, doubling the national total to 16. The sharp steps in 2010 and 2013 correspond to three dedications in each year, showing that new recognitions arrived in bursts rather than at a steady annual rate. Growth then became less frequent: Noosa joined in 2015, Bondi in 2017 and Norah Head in 2022, bringing the register to 19. This change in pace suggests a transition from the program's initial rollout and national expansion to a more selective period of individual local dedications. Because communities must develop nominations, local steering committees and public support, dedication dates reflect the work of organising and recognising existing surfing heritage. The long interval between Bondi and Norah Head is particularly striking: five years passed between those additions to the register.",
    "sources": [
      {
        "label": "National Surfing Reserves — Official Register",
        "url": "https://surfingreserves.org.au/national-surfing-reserves/"
      },
      {
        "label": "National Surfing Reserves — Nomination Process",
        "url": "https://surfingreserves.org.au/nomination-process/"
      },
      {
        "label": "Maroubra — First National Surfing Reserve",
        "url": "https://surfingreserves.org.au/maroubra/"
      }
    ]
  },
  "width": "container",
  "height": 350,
  "background": "#ffffff",
  "padding": {
    "left": 8,
    "right": 10,
    "top": 10,
    "bottom": 5
  },
  "layer": [
    {
      "data": {"url": "data/reserves.csv"},
      "transform": [
        {
          "aggregate": [
            {"op": "count", "as": "new_reserves"}
          ],
          "groupby": ["year"]
        },
        {
          "window": [
            {
              "op": "sum",
              "field": "new_reserves",
              "as": "total"
            }
          ],
          "sort": [
            {"field": "year", "order": "ascending"}
          ],
          "frame": [null, 0]
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "step-after",
        "strokeWidth": 3.5,
        "color": "#087789",
        "point": {
          "filled": true,
          "size": 85,
          "fill": "#087789",
          "stroke": "#ffffff",
          "strokeWidth": 1.5
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year of dedication",
          "scale": {
            "domain": [2005.5, 2026],
            "nice": false
          },
          "axis": {
            "values": [2006, 2009, 2013, 2017, 2022, 2025],
            "format": "d",
            "grid": false,
            "labelColor": "#4f6972",
            "titleColor": "#244654",
            "titleFontWeight": "bold",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "titlePadding": 12
          }
        },
        "y": {
          "field": "total",
          "type": "quantitative",
          "title": "Cumulative recognised reserves",
          "scale": {
            "domain": [0, 22],
            "nice": false
          },
          "axis": {
            "values": [0, 4, 8, 12, 16, 20],
            "grid": true,
            "gridColor": "#e4efed",
            "domain": false,
            "labelColor": "#4f6972",
            "titleColor": "#244654",
            "titleFontWeight": "bold",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "titlePadding": 12
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "format": "d",
            "title": "Year"
          },
          {
            "field": "new_reserves",
            "type": "quantitative",
            "title": "Newly dedicated"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Cumulative total"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "left": 2006,
            "right": 2011.1,
            "bottom": 10.6,
            "top": 13,
            "phase": "early"
          },
          {
            "left": 2010.2,
            "right": 2016.3,
            "bottom": 19.1,
            "top": 21.5,
            "phase": "middle"
          },
          {
            "left": 2018.2,
            "right": 2025.7,
            "bottom": 12.8,
            "top": 15.2,
            "phase": "late"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "left", "type": "quantitative"},
        "x2": {"field": "right"},
        "y": {"field": "bottom", "type": "quantitative"},
        "y2": {"field": "top"},
        "fill": {
          "field": "phase",
          "type": "nominal",
          "scale": {
            "domain": ["early", "middle", "late"],
            "range": ["#e3f2f7", "#e3f3ea", "#fff0dd"]
          },
          "legend": null
        },
        "stroke": {
          "field": "phase",
          "type": "nominal",
          "scale": {
            "domain": ["early", "middle", "late"],
            "range": ["#89c6da", "#9cccb4", "#ebc28c"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2009,
            "from": 9,
            "to": 10.6,
            "phase": "early"
          },
          {
            "year": 2013,
            "from": 16.9,
            "to": 19.1,
            "phase": "middle"
          },
          {
            "year": 2022,
            "from": 15.2,
            "to": 18.1,
            "phase": "late"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1.8
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "from", "type": "quantitative"},
        "y2": {"field": "to"},
        "color": {
          "field": "phase",
          "type": "nominal",
          "scale": {
            "domain": ["early", "middle", "late"],
            "range": ["#0072B2", "#009E73", "#D55E00"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2009,
