{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Three equally scaled maps showing how National Surfing Reserve recognition spread across Australia over time.",
  "usermeta": {
    "title": "How Did Surfing Reserve Recognition Spread Across Australia?",
    "analysis": "Recognition began with a strong New South Wales focus: all eight reserves dedicated between 2006 and 2009 were in that state. The next eight dedications, between 2010 and 2013, expanded the register to five states. Western Australia entered in 2010, Queensland in 2012, and South Australia and Victoria in 2013; New South Wales also added Manly–Freshwater in 2010. By the end of 2013, 16 of the eventual 19 listed reserves had been recognised. The final three entries were Noosa (2015), Bondi (2017) and Norah Head (2022). This progression shows the geographic expansion of formal recognition, rather than the emergence of surfing itself: these communities had surfing histories before their dedication dates. Recognition timing may also reflect nominations, local support and administrative processes, so the maps should not be interpreted as a timeline of surfing popularity. The consistent national map extent across all three panels supports direct comparison.",
    "source": {
      "label": "National Surfing Reserves — Official Dedication Register",
      "url": "https://surfingreserves.org.au/national-surfing-reserves/"
    }
  },
  "background": "#ffffff",
  "spacing": 18,
  "hconcat": [
    {
      "title": {
        "text": "2006–2009",
        "subtitle": "8 New • NSW Only",
        "anchor": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#153D4A",
        "subtitleFontSize": 11,
        "subtitleFontWeight": "bold",
        "subtitleColor": "#0C6B7A"
      },
      "width": 280,
      "height": 220,
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "data": {
            "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
            "format": {
              "type": "topojson",
              "feature": "countries"
            }
          },
          "transform": [
            {
              "filter": "datum.id == 36 || datum.id == '036'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#EAF3F0",
            "stroke": "#A7C2BF",
            "strokeWidth": 1.1
          }
        },
        {
          "data": {
            "url": "data/reserves.csv"
          },
          "transform": [
            {
              "filter": "datum.year >= 2006 && datum.year <= 2009"
            }
          ],
          "mark": {
            "type": "circle",
            "filled": true,
            "size": 115,
            "opacity": 0.98,
            "stroke": "#FFFFFF",
            "strokeWidth": 1.4,
            "color": "#0C6B7A"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "Reserve"
              },
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "year",
                "type": "quantitative",
                "format": "d",
                "title": "Dedicated"
              }
            ]
          }
        }
      ]
