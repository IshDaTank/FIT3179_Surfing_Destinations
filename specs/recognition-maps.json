    {
      "title": {
        "text": "2006–2009",
        "subtitle": "8 new · NSW only",
        "anchor": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#153D4A",
        "subtitleFontSize": 11,
        "subtitleColor": "#0C6B7A",
        "offset": 12
      },
