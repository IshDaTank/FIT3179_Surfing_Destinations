  "transform": [
    {
      "calculate": "datum.monthIndex - 1 + 0.025",
      "as": "monthStart"
    },
    {
      "calculate": "datum.monthIndex - 0.025",
      "as": "monthEnd"
    },
    {
      "calculate": "datum.monthIndex - 0.5",
      "as": "monthMid"
    },
    {
      "calculate": "datum.location === 'Snapper Rocks' ? 2.71 : datum.location === 'Mystics' ? 1.78 : 0.85",
      "as": "inner"
    },
    {
      "calculate": "datum.location === 'Snapper Rocks' ? 3.51 : datum.location === 'Mystics' ? 2.58 : 1.65",
      "as": "outer"
    },
    {
      "calculate": "(datum.inner + datum.outer) / 2",
      "as": "midRadius"
    },
    {
      "calculate": "format(datum.surfablePct, '.0f') + '%'",
      "as": "percentageLabel"
    }
  ],

  "layer": [
    {
      "description": "Thirty-six coloured radial segments encoding monthly surfability values. Ring position identifies the surf location.",

      "mark": {
        "type": "arc",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 3
      },

      "encoding": {
        "theta": {
          "field": "monthStart",
          "type": "quantitative",
          "scale": {
            "domain": [0, 12],
            "range": [0, 6.283185307179586]
          },
          "axis": null
        },

        "theta2": {
          "field": "monthEnd"
        },

        "radius": {
          "field": "outer",
          "type": "quantitative",
          "scale": {
            "domain": [0, 4.5],
            "range": [0, 258]
          }
        },

        "radius2": {
          "field": "inner"
        },

        "color": {
          "field": "surfablePct",
          "type": "quantitative",

          "scale": {
            "domain": [15, 40],
            "range": [
              "#00204C",
              "#535F6E",
              "#A69C6C",
              "#FDE945"
            ],
            "interpolate": "rgb"
          },

          "legend": {
            "title": "Modelled surfable hours (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 350,
            "gradientThickness": 15,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "titleColor": "#183E52",
            "labelColor": "#183E52",
            "values": [
              15,
              20,
              25,
              30,
              35,
              40
            ]
          }
        },

        "tooltip": [
          {
            "field": "location",
            "type": "nominal",
            "title": "Surf location"
          },
          {
            "field": "month",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "surfablePct",
            "type": "quantitative",
            "title": "Modelled surfable hours (%)",
            "format": ".0f"
          }
        ]
      }
    },

    {
      "description": "High-contrast percentage labels displayed inside each radial segment.",

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 9,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle"
      },

      "encoding": {
        "theta": {
          "field": "monthMid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 12],
            "range": [0, 6.283185307179586]
          }
        },

        "radius": {
          "field": "midRadius",
          "type": "quantitative",
          "scale": {
            "domain": [0, 4.5],
            "range": [0, 258]
          }
        },

        "text": {
          "field": "percentageLabel",
          "type": "nominal"
        },

        "color": {
          "condition": {
            "test": "datum.surfablePct >= 29",
            "value": "#132D40"
          },
          "value": "#FFFFFF"
        }
      }
    },

    {
      "description": "Month labels positioned outside the outermost Snapper Rocks ring.",

      "transform": [
        {
          "filter": "datum.location === 'Snapper Rocks'"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#183E52",
        "align": "center",
        "baseline": "middle"
      },

      "encoding": {
        "theta": {
          "field": "monthMid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 12],
            "range": [0, 6.283185307179586]
          }
        },

        "radius": {
          "datum": 4.15,
          "type": "quantitative",
          "scale": {
            "domain": [0, 4.5],
            "range": [0, 258]
          }
        },

        "text": {
          "field": "month",
          "type": "nominal"
        }
      }
    }
