        {
          "filter": "datum.location === 'Snapper Rocks'"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#183e52",
        "baseline": "middle"
      },

      "encoding": {
        "theta": {
          "field": "monthMid",
          "type": "quantitative",
          "scale": {
            "domain": [0,12],
            "range": [0,6.283185307179586]
          }
        },

        "radius": {
          "datum": 4.15,
          "type": "quantitative",
          "scale": {
            "domain": [0,4.5],
            "range": [0,258]
          }
        },

        "text": {
          "field": "month",
          "type": "nominal"
        }
      }
    }
