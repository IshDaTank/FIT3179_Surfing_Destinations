  "transform": [
    {
      "calculate": "datum.monthIndex - 1 + 0.025",
      "as": "monthStart"
    },
    {
      "calculate": "datum.monthIndex - 0.025",
      "as": "monthEnd"
    },
    {
      "calculate": "datum.monthIndex - 0.5",
      "as": "monthMid"
    },
    {
      "calculate": "datum.location === 'Snapper Rocks' ? 2.71 : datum.location === 'Mystics' ? 1.78 : 0.85",
      "as": "inner"
    },
    {
      "calculate": "datum.location === 'Snapper Rocks' ? 3.51 : datum.location === 'Mystics' ? 2.58 : 1.65",
      "as": "outer"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "arc",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 3
      },

      "encoding": {
        "theta": {
          "field": "monthStart",
          "type": "quantitative",
          "scale": {
            "domain": [0,12],
            "range": [0,6.283185307179586]
          },
          "axis": null
        },

        "theta2": {
          "field": "monthEnd"
        },

        "radius": {
          "field": "outer",
          "type": "quantitative",
          "scale": {
            "domain": [0,4.5],
            "range": [0,258]
          }
        },

        "radius2": {
          "field": "inner"
        },

        "color": {
          "field": "surfablePct",
          "type": "quantitative",

          "scale": {
            "domain": [15,40],
            "range": [
              "#e5f3f5",
              "#85c9cc",
              "#268b9e",
              "#124b70"
            ]
          },

          "legend": {
            "title": "Modelled surfable hours (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 320,
            "gradientThickness": 12,
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },

        "tooltip": [
          {
            "field": "location",
            "type": "nominal",
            "title": "Surf location"
          },
          {
            "field": "month",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "surfablePct",
            "type": "quantitative",
            "title": "Surfable hours (%)",
            "format": ".0f"
          }
        ]
      }
    },

    {
