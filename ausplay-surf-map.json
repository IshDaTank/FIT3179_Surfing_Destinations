{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#31535f",
      "titleColor": "#31535f",
      "gridColor": "#e4eeec"
    },
    "text": {
      "font": "Arial"
    }
  },
  "description": "Proportional symbol map for estimated people aged 15+ who surfed in 2025, by Australian state or territory. ACT has no coastline; its symbol represents residents, not a surf site.",
  "usermeta": {
    "title": "Where Are Australia’s Surfers?",
    "annotation": "NSW: 117,953 adult participants — the largest estimated total.",
    "analysis": "New South Wales accounts for the largest estimated adult surfing population (117,953), followed by Queensland (63,787), Victoria (58,683) and Western Australia (43,496). The symbols show where participants reside by state or territory, not where surfing takes place. In particular, the ACT’s 2,272 participants reflect residents who surf, despite the territory having no coastline. Participation rates provide a different perspective: WA leads at 1.76%, slightly ahead of NSW at 1.67%. Estimates are survey-based, and small jurisdictions warrant care.",
    "sources": [
      {
        "label": "Australian Sports Commission · AusPlay 2025, state and territory tables (30 Apr 2026)",
        "url": "https://www.ausport.gov.au/clearinghouse/research/ausplay/results"
      }
    ]
  },
  "height": 450,
  "projection": {
    "type": "mercator",
    "center": [
      133.5,
      -27.4
    ],
    "scale": 720
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36 || datum.id == \"036\""
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eef5f3",
        "stroke": "#a6bcbc",
        "strokeWidth": 1.35
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_map_2025.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.83,
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "participants",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              120000
            ],
            "range": [
              36,
              2600
            ]
          },
          "legend": {
            "title": "Estimated surfers (15+)",
            "format": ",.0f"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "QLD",
              "VIC",
              "WA",
              "SA",
              "TAS",
              "ACT",
              "NT"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73",
              "#7B61A8",
              "#8C6D31",
              "#666666"
            ]
          },
          "legend": {
            "title": "State / territory",
            "orient": "bottom",
            "columns": 4,
            "symbolSize": 110
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "participants",
            "title": "Estimated participants aged 15+",
            "format": ","
          },
          {
            "field": "participation_rate_pct",
            "title": "Adult participation rate",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ausplay_surf_map_2025.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": -14,
        "color": "#204551"
      },
      "encoding": {
        "longitude": {
          "field": "longitude"
        },
        "latitude": {
          "field": "latitude"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ]
}